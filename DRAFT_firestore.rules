rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Connectivity check document (read-only)
    match /test/connection {
      allow get: if true;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'rajaschool66@gmail.com'
      );
    }

    // --- Entity Validation Helpers ---
    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid', 'email', 'fullName', 'phone', 'province',
        'city', 'address', 'postalCode', 'profileCompleted', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'email', 'fullName', 'phone', 'province',
        'city', 'address', 'postalCode', 'profileCompleted', 'createdAt', 'updatedAt'
      ]) &&
      data.uid is string && data.uid == request.auth.uid && isValidId(data.uid) &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
      data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
      data.phone is string && data.phone.size() <= 20 &&
      data.province is string && data.province.size() <= 60 &&
      data.city is string && data.city.size() <= 60 &&
      data.address is string && data.address.size() <= 300 &&
      data.postalCode is string && data.postalCode.size() <= 20 &&
      data.profileCompleted is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidCartItem(data) {
      return data.keys().hasAll(['productId', 'quantity', 'addedAt']) &&
      data.keys().hasOnly(['productId', 'quantity', 'addedAt']) &&
      isValidId(data.productId) && data.productId.size() <= 80 &&
      data.quantity is int && data.quantity >= 1 && data.quantity <= 20 &&
      data.addedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
        'orderNumber', 'userId', 'customerName', 'customerPhone', 'shippingAddress',
        'shippingMethod', 'paymentMethod', 'discountCode', 'subtotal', 'shippingCost',
        'discountAmount', 'totalAmount', 'status', 'itemsCount', 'itemsSummary',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'orderNumber', 'userId', 'customerName', 'customerPhone', 'shippingAddress',
        'shippingMethod', 'paymentMethod', 'discountCode', 'subtotal', 'shippingCost',
        'discountAmount', 'totalAmount', 'status', 'itemsCount', 'itemsSummary',
        'createdAt', 'updatedAt'
      ]) &&
      data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 30 &&
      data.userId is string && isValidId(data.userId) &&
      data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
      data.customerPhone is string && data.customerPhone.size() >= 8 && data.customerPhone.size() <= 20 &&
      data.shippingAddress is string && data.shippingAddress.size() >= 5 && data.shippingAddress.size() <= 350 &&
      data.shippingMethod in ['express', 'post', 'pickup'] &&
      data.paymentMethod in ['online', 'cod'] &&
      data.discountCode is string && data.discountCode.size() <= 30 &&
      data.subtotal is number && data.subtotal >= 0 &&
      data.shippingCost is number && data.shippingCost >= 0 &&
      data.discountAmount is number && data.discountAmount >= 0 &&
      data.totalAmount is number && data.totalAmount >= 0 &&
      data.status in ['confirmed', 'preparing', 'shipped', 'delivered', 'cancelled'] &&
      data.itemsCount is int && data.itemsCount >= 1 && data.itemsCount <= 50 &&
      data.itemsSummary is string && data.itemsSummary.size() >= 1 && data.itemsSummary.size() <= 600 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidOrderItem(data, orderId) {
      return data.keys().hasAll(['orderId', 'userId', 'productId', 'title', 'unitPrice', 'quantity']) &&
      data.keys().hasOnly(['orderId', 'userId', 'productId', 'title', 'unitPrice', 'quantity']) &&
      data.orderId is string && data.orderId == orderId && isValidId(data.orderId) &&
      data.userId is string && data.userId == request.auth.uid && isValidId(data.userId) &&
      data.productId is string && data.productId.size() <= 80 && isValidId(data.productId) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
      data.unitPrice is number && data.unitPrice >= 0 &&
      data.quantity is int && data.quantity >= 1 && data.quantity <= 20;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['productId', 'userId', 'authorName', 'rating', 'comment', 'createdAt']) &&
      data.keys().hasOnly(['productId', 'userId', 'authorName', 'rating', 'comment', 'createdAt']) &&
      data.productId is string && data.productId.size() <= 80 && isValidId(data.productId) &&
      data.userId is string && data.userId == request.auth.uid && isValidId(data.userId) &&
      data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 80 &&
      data.rating is int && data.rating >= 1 && data.rating <= 5 &&
      data.comment is string && data.comment.size() >= 3 && data.comment.size() <= 600 &&
      data.createdAt is timestamp;
    }

    // --- Collection Rules ---

    // Private User Profile (PII isolated to owner or admin)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create: if isValidId(userId) && isVerifiedUser() && isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isVerifiedUser() && isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'fullName', 'phone', 'province', 'city', 'address',
          'postalCode', 'profileCompleted', 'updatedAt'
        ]);

      // Persistent Cart Subcollection (Master Gate checks parent user doc)
      match /cart/{itemId} {
        allow get: if isValidId(userId) && isValidId(itemId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(itemId) && isVerifiedUser() && isOwner(userId) &&
          isValidCartItem(incoming()) &&
          incoming().addedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId) && isValidId(itemId) && isVerifiedUser() && isOwner(userId) &&
          isValidCartItem(incoming()) &&
          incoming().productId == existing().productId &&
          incoming().addedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['quantity', 'addedAt']) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId) && isValidId(itemId) && isVerifiedUser() && isOwner(userId);
      }
    }

    // Customer Orders (PII restricted to order owner or admin)
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(orderId) && isVerifiedUser() &&
        isValidOrder(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'confirmed' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(orderId) && isVerifiedUser() &&
        isValidOrder(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().orderNumber == existing().orderNumber &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            existing().status in ['confirmed', 'preparing'] &&
            incoming().status == 'cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      // Order Line Items Subcollection (Atomic Master Gate)
      match /items/{itemId} {
        allow get: if isValidId(orderId) && isValidId(itemId) && isSignedIn() && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid || isAdmin()
        );
        allow list: if isValidId(orderId) && isSignedIn() && (
          resource.data.userId == request.auth.uid || isAdmin()
        );
        allow create: if isValidId(orderId) && isValidId(itemId) && isVerifiedUser() &&
          isValidOrderItem(incoming(), orderId) &&
          getAfter(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid;
      }
    }

    // Public Product Reviews (No PII, verified users can create/edit/delete own)
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if resource.data.productId is string && resource.data.rating >= 1 && resource.data.rating <= 5;
      allow create: if isValidId(reviewId) && isVerifiedUser() &&
        isValidReview(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(reviewId) && isVerifiedUser() &&
        existing().userId == request.auth.uid &&
        isValidReview(incoming()) &&
        incoming().productId == existing().productId &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment']);
      allow delete: if isValidId(reviewId) && isVerifiedUser() && (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
